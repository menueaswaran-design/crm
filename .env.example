# MongoDB (Atlas/local)
MONGODB_URI=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Demo mode (keep false for production-only setup)
NEXT_PUBLIC_DEMO_MODE=false

# Used to sign demo-mode tokens when Firebase is not configured
DEMO_JWT_SECRET=change-me-in-production

# Bootstrap admin account (auto-created on first DB connect)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Secret for signing the demo auth JWT (fallback token path)
NEXTAUTH_SECRET=change-me-in-production
