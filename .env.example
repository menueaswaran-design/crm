# MongoDB (Atlas/local)
MONGODB_URI=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Demo mode (keep false for production-only setup)
NEXT_PUBLIC_DEMO_MODE=false

# Used to sign demo-mode tokens when Firebase is not configured
DEMO_JWT_SECRET=change-me-in-production

# Bootstrap admin account (auto-created on first DB connect)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Secret for signing the demo auth JWT (fallback token path)
NEXTAUTH_SECRET=change-me-in-production

# Public URL of the app (used to build password-reset links in emails)
APP_URL=http://localhost:3000

# Password reset email (SMTP) — used to send reset links for CRM accounts
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CA Office CRM <no-reply@yourdomain.com>

# Firebase REST API key (same as NEXT_PUBLIC_FIREBASE_API_KEY). Lets the server
# send/reset password emails through Firebase when SMTP is not configured.
FIREBASE_API_KEY=

# How long a password-reset link stays valid (minutes). Default: 60.
RESET_TOKEN_TTL_MINUTES=60
